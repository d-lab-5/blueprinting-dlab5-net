# Credentials for the live verification scripts. Copy to .env.local and fill in.
#
#   cp .env.example .env.local
#   chmod 600 .env.local
#   $EDITOR .env.local
#
# Then, for any of verify:auth, verify:model-store, verify:ui, seed, export:
#
#   set -a; source .env.local; set +a
#   npm run verify:ui
#
# .env.local is covered by .gitignore (.env.*), and this file — which carries
# no values — is the one exception that is committed. Never put a real password
# in here, and never behind a GATSBY_ prefix: those are inlined into the public
# bundle at build time.
#
# These are only ever read by scripts/ on this machine. Nothing in packages/
# reads them, and they are not sent anywhere except to Cognito by the same
# aws-amplify/auth client the app itself uses.

BP_USER=
BP_PASSWORD=
