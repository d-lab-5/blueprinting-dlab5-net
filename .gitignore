# ---------------------------------------------------------------------------
# blueprinting-dlab5-net
# ---------------------------------------------------------------------------

# Gatsby
.cache/
public/

# Amplify Gen 2. amplify_outputs.json is generated by `ampx sandbox` or by
# `ampx pipeline-deploy` and copied into packages/site/src at build time — it
# is environment state, not source, so it is never committed.
amplify_outputs.json
amplify_outputs.d.ts
.amplify/

# Workspace package build output. The one exception is
# packages/metamodel/src/generated/, which IS committed: it is generated from
# the pinned ontology so that Amplify Hosting builds are deterministic and
# need no ontology toolchain.
packages/*/dist/

# JetBrains
.idea/

# Scratch space for specs and notes that are not yet part of the repo
temp/

# ---------------------------------------------------------------------------
# Secrets hygiene — THIS REPOSITORY IS PUBLIC.
#
# Nothing below is ever committed. GitHub secret scanning and push protection
# are enabled on the repo as a backstop, but the backstop is not the plan.
#
# Also never commit, even though they are not matched by a pattern:
#   - AWS account IDs and ARNs (780…-style numbers) in code, docs or ADRs
#   - Cognito user-pool / identity-pool / AppSync IDs (that is why
#     amplify_outputs.json is ignored above)
#   - customer or colleague names, emails and internal hostnames in seed data
# GATSBY_*-prefixed environment variables are inlined into the public bundle
# at build time. Never put a secret behind a GATSBY_ prefix.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
id_rsa*
credentials
aws-exports.js

# Regenerated by Gatsby on every develop/build (graphqlTypegen). Nothing
# depends on it at review time, so it stays out rather than churning.
packages/site/src/gatsby-types.d.ts
