{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Stacks",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:eu-central-1:*:stack/project-docs-mcp/*",
        "arn:aws:cloudformation:eu-central-1:*:stack/aws-sam-cli-managed-default/*"
      ]
    },
    {
      "Sid": "StackTooling",
      "Effect": "Allow",
      "Action": [
        "cloudformation:CreateChangeSet",
        "cloudformation:ValidateTemplate",
        "cloudformation:GetTemplateSummary",
        "cloudformation:ListStacks"
      ],
      "Resource": "*"
    },
    {
      "Sid": "Buckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::project-docs-mcp-*",
        "arn:aws:s3:::aws-sam-cli-managed-default-*"
      ]
    },
    {
      "Sid": "FunctionRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:UpdateRole",
        "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:GetRolePolicy", "iam:DeleteRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy"
      ],
      "Resource": "arn:aws:iam::*:role/project-docs-mcp-*"
    },
    {
      "Sid": "PassFunctionRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/project-docs-mcp-*",
      "Condition": { "StringEquals": { "iam:PassedToService": "lambda.amazonaws.com" } }
    },
    {
      "Sid": "Function",
      "Effect": "Allow",
      "Action": "lambda:*",
      "Resource": "arn:aws:lambda:eu-central-1:*:function:project-docs-mcp"
    },
    {
      "Sid": "AdapterLayer",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:eu-central-1:*:layer:LambdaAdapterLayerArm64:*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup", "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy", "logs:DeleteRetentionPolicy",
        "logs:TagResource", "logs:UntagResource", "logs:ListTagsForResource",
        "logs:FilterLogEvents", "logs:GetLogEvents", "logs:DescribeLogStreams",
        "logs:StartLiveTail"
      ],
      "Resource": "arn:aws:logs:eu-central-1:*:log-group:/aws/lambda/project-docs-mcp*"
    },
    {
      "Sid": "DescribeLogs",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    },
    {
      "Sid": "ApiKey",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter", "ssm:GetParameter", "ssm:DeleteParameter",
        "ssm:AddTagsToResource", "ssm:ListTagsForResource"
      ],
      "Resource": "arn:aws:ssm:eu-central-1:*:parameter/project-docs-mcp/*"
    },
    {
      "Sid": "ApiKeyEncryption",
      "Effect": "Allow",
      "Action": ["kms:Encrypt", "kms:Decrypt", "kms:GenerateDataKey"],
      "Resource": "*",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.eu-central-1.amazonaws.com" } }
    }
  ]
}
