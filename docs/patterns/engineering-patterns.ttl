_:p-e-component-workspace-transforms-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "packages/blockly/src/transform.ts".
<https://blueprinting.dlab5.net/i/patterns/Constraint/constraint-backend-not-a-workspace> a archimate:Constraint;
    archimate:identifier "constraint-backend-not-a-workspace";
    archimate:name "The backend must not be an npm workspace";
    archimate:documentation "Gatsby needs graphql 16 and the Amplify data construct needs graphql 15. One hoisted dependency tree cannot satisfy both. Tidying the layout by making backend/ a workspace reintroduces the conflict.";
    archimate:hasProperty _:p-e-constraint-backend-not-a-workspace-0.
_:p-e-constraint-backend-not-a-workspace-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "amplify.yml; docs/adr/0001".
<https://blueprinting.dlab5.net/i/patterns/Constraint/constraint-blocks-generated-not-written> a archimate:Constraint;
    archimate:identifier "constraint-blocks-generated-not-written";
    archimate:name "Blocks and toolbox are generated from the ontology";
    archimate:documentation "Re-pinning the ontology regenerates the palette instead of starting an editing job across dozens of block definitions.";
    archimate:hasProperty _:p-e-constraint-blocks-generated-not-written-0.
_:p-e-constraint-blocks-generated-not-written-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "packages/blockly/src/generate.ts; digitalhome-cloud-modeler blocklyGenerator.js".
<https://blueprinting.dlab5.net/i/patterns/Constraint/constraint-frontend-builds-without-outputs> a archimate:Constraint;
    archimate:identifier "constraint-frontend-builds-without-outputs";
    archimate:name "The frontend build must succeed with no amplify_outputs.json";
    archimate:documentation "A frontend-only rebuild runs no backend phase. Configure Amplify in gatsby-browser only, never in gatsby-ssr, and let the outputs copy fail.";
    archimate:hasProperty _:p-e-constraint-frontend-builds-without-outputs-0.
_:p-e-constraint-frontend-builds-without-outputs-0 a archimate:Property;
    archimate:propertyKey "reference";
