<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-groups-are-the-access-rule> a archimate:Constraint;
    archimate:identifier "constraint-groups-are-the-access-rule";
    archimate:name "Tenant admins and space readers are groups, created by one function";
    archimate:documentation "Static storage and data rules cannot name a tenant that did not exist at deploy time, so access is by groups (admins per tenant, readers per space) and one function is the only writer of them.";
    archimate:hasProperty _:p-e-constraint-groups-are-the-access-rule-0.
_:p-e-constraint-groups-are-the-access-rule-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-cloud backend/amplify/functions/households; template-dlab5-cloud functions/tenants".
<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-operators-read-no-content> a archimate:Constraint;
    archimate:identifier "constraint-operators-read-no-content";
    archimate:name "Operators run the platform and read no tenant content";
    archimate:documentation "Operators create tenants and see names and edges; content needs membership of a space group, which an operator does not get by being one.";
    archimate:hasProperty _:p-e-constraint-operators-read-no-content-0.
_:p-e-constraint-operators-read-no-content-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-cloud docs/adr/0010; backend/amplify/data/resource.ts".
<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-private-data-stays-local> a archimate:Constraint;
    archimate:identifier "constraint-private-data-stays-local";
    archimate:name "Private data stays on the edge";
    archimate:documentation "Biometrics, raw sensor data and anything the tenant marks private never go to the cloud or to the model. The agent sees catalog data and names, and a picture only when asked.";
    archimate:hasProperty _:p-e-constraint-private-data-stays-local-0.
_:p-e-constraint-private-data-stays-local-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-edge README (privacy)".
<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-sync-is-three-way> a archimate:Constraint;
    archimate:identifier "constraint-sync-is-three-way";
    archimate:name "Sync merges three ways; a stale write is a 409";
    archimate:documentation "Each side keeps the version it last saw. A write against an older version is refused and merged, never overwritten.";
    archimate:hasProperty _:p-e-constraint-sync-is-three-way-0.
_:p-e-constraint-sync-is-three-way-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-edge sync.py; mediathek-digitalhome-cloud backend/amplify/functions/graphs".
<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-tombstone-is-not-a-revoke> a archimate:Constraint;
    archimate:identifier "constraint-tombstone-is-not-a-revoke";
    archimate:name "A deleted item answers 410 with its own code, not a revoke";
    archimate:documentation "An edge treats a bare 410 as its link being revoked. A permanently deleted item must say so in its own error code, or an edge unlinks itself.";
    archimate:hasProperty _:p-e-constraint-tombstone-is-not-a-revoke-0.
_:p-e-constraint-tombstone-is-not-a-revoke-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-edge cloud.py (deleted_in_mediathek)".
<https://blueprinting.dlab5.net/i/cloud-edge/Constraint/constraint-version-gate> a archimate:Constraint;
    archimate:identifier "constraint-version-gate";
    archimate:name "A cloud refuses edges older than its minimum";
    archimate:documentation "Every edge call names the edge version; below the minimum the cloud answers 426, so an edge without the latest fixes cannot work.";
    archimate:hasProperty _:p-e-constraint-version-gate-0.
_:p-e-constraint-version-gate-0 a archimate:Property;
    archimate:propertyKey "reference";
    archimate:propertyValue "mediathek-digitalhome-cloud backend/amplify/functions/edge-shared/http.ts".
