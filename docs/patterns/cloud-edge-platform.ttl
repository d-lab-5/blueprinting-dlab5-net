    archimate:identifier "assessment-tombstone-would-unlink";
    archimate:name "A tombstone almost unlinked every edge";
    archimate:documentation "The first version of permanent deletion answered 410 for a purged item, which the edge read as its token being revoked. Found in review before release.";
    archimate:hasProperty _:p-e-assessment-tombstone-would-unlink-0.
_:p-e-assessment-tombstone-would-unlink-0 a archimate:Property;
    archimate:propertyKey "instances";
    archimate:propertyValue "mediathek-digitalhome-edge".
<https://blueprinting.dlab5.net/i/cloud-edge/Grouping/blueprint-cloud-edge> a archimate:Grouping;
    archimate:identifier "blueprint-cloud-edge";
    archimate:name "Blueprint: Cloud and edge platform";
    archimate:documentation "A cloud that holds tenants and their spaces, and edges that people, homes or robots run locally and link to it. The cloud is the shared catalog and the place where people approve; the edge is where data is made and where private data stays.";
    archimate:hasProperty _:p-e-blueprint-cloud-edge-0.
_:p-e-blueprint-cloud-edge-0 a archimate:Property;
    archimate:propertyKey "instances";
    archimate:propertyValue "mediathek-digitalhome-cloud + mediathek-digitalhome-edge; digitalhome-cloud-darkfactory + digitalhome-edge".
