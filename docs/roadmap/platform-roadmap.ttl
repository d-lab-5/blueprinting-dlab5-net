<https://blueprinting.dlab5.net/i/blueprinting/WorkPackage/wp6-2-relationships-as-typed-variable-references> a archimate:WorkPackage;
    archimate:identifier "wp6-2-relationships-as-typed-variable-references";
    archimate:name "WP6.2 Relationships as typed variable references";
    archimate:documentation "ArchiMate is a graph and Blockly is a tree. Nesting expresses composition and aggregation only; every other relationship is a field_variable whose variableTypes come from allowedTargets, so Blockly itself refuses an illegal connection at connect time rather than a validator rejecting it afterwards.";
    archimate:hasProperty _:p-e-wp6-2-relationships-as-typed-variable-references-0.
_:p-e-wp6-2-relationships-as-typed-variable-references-0 a archimate:Property;
